{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daily-walkthrough-pwa",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-31",
  // Sync persistence (Live Sync): KV namespace created via dashboard,
  // bound here so /api/sync data survives across requests/isolates.
  "kv_namespaces": [
    {
      "binding": "EHS_KV",
      "id": "31338bec725d4814be9b30daf79fadff"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  }
}
