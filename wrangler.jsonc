{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daily-walkthrough-pwa",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-31",
  // Preserve the legacy KV binding for migration; SyncRoom owns new writes.
  "kv_namespaces": [
    {
      "binding": "EHS_KV",
      "id": "31338bec725d4814be9b30daf79fadff"
    }
  ],
  "durable_objects": { "bindings": [{ "name": "EHS_ROOMS", "class_name": "SyncRoom" }] },
  "migrations": [{ "tag": "sync-v2", "new_sqlite_classes": ["SyncRoom"] }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  }
}
